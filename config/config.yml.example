# Living Ink Configuration

# 1. AI Text Cleanup Configuration
# Choose your AI provider for cleaning up OCR text.
# Available presets: "openai", "gemini", "ollama", "groq", "openrouter", "mistral", "together", "custom", "none"
ai:
  provider: "gemini"                    # Pick your provider
  api_key: "YOUR-API-KEY-HERE"          # Your API key (not needed for "ollama" or "none")
  # model: "gemini-2.0-flash"           # Optional — a sensible default is auto-selected per provider
  # temperature: 0.3                    # Optional — controls creativity (lower = more precise)

  # --- Provider-specific notes ---
  # "gemini"   → Get a free API key at https://aistudio.google.com/apikey
  # "openai"   → Get an API key at https://platform.openai.com/api-keys
  # "ollama"   → Free, local. Install from https://ollama.com, then `ollama pull llama3.2`
  # "groq"     → Free tier at https://console.groq.com
  # "openrouter" → Aggregator with free models at https://openrouter.ai
  # "custom"   → Any OpenAI-compatible endpoint. Requires 'base_url' below.
  # "none"     → Disable AI cleanup entirely. Raw OCR text only.

  # For provider: "custom" only:
  # base_url: "https://my-llm.example.com/v1"

# DEPRECATED — still works for backward compatibility:
# openai:
#   api_key: "sk-proj-YOUR-OPENAI-KEY-HERE"

# 2. reMarkable Tablet Connection
# Choose your preferred connection method: "ssh" (USB first, Cloud backup) or "cloud" (Cloud first, USB backup).
remarkable:
  preferred_connection: "ssh"          # "ssh" (Recommended — Free, fast, offline) or "cloud"

  # USB SSH Settings (Used first if preferred_connection: "ssh", or as backup if "cloud")
  # Connect tablet via USB-C. Enable developer mode on tablet:
  # Settings → General → Software → Developer mode
  use_ssh: true
  ssh_host: "10.11.99.1"               # Default USB IP for reMarkable
  ssh_port: 22
  ssh_password: ""                     # Root password from Developer mode screen (or leave empty if using SSH keys)
  # ssh_user: "root"                   # Default: root

  # reMarkable Cloud Settings (Used first if preferred_connection: "cloud", or as backup if "ssh")
  # Get your token by running 'living-ink setup' or checking ~/.rmapi
  # device_token: "YOUR-DEVICE-TOKEN-HERE"

# 3. Google Cloud Vision Configuration (OPTIONAL)
# Not needed if you use an AI provider with vision support (e.g., Gemini, OpenAI GPT-4o).
# These providers can read handwriting directly from images — no separate OCR service needed.
# Only configure this if you prefer Google Cloud Vision for OCR accuracy or already have credentials.
google_vision:
  # Option A: Path to your Service Account JSON file
  # Example: "/Users/alice/Documents/my-google-creds.json"
  credentials_path: ""

  # Option B: Paste the full JSON content (Advanced)
  # Only use this if you want the credentials inside this file.
  # Ensure indentation is correct (4 spaces).
  # credentials_json: |
  #   {
  #     "type": "service_account",
  #     ...
  #   }

# 4. Sync Configuration (Optional)
sync:
  # How many notebooks to process in a single run (useful for rate limits)
  # Default: 1
  max_notebooks_per_run: 5

# 5. Destinations (Toggle as needed)
# You can enable one or both destinations.

apple_notes:
  enabled: true
  # The folder in Apple Notes where new notes will be created.
  folder_name: "Living Ink"

obsidian:
  enabled: false
  # Absolute path to your Obsidian Vault root
  # Example: "/Users/username/Documents/MyVault"
  vault_path: ""

  # Optional: Folder inside the vault where notes will be stored.
  # If omitted or empty (""), notes are placed directly in the vault root.
  # Example: "Living Ink" or "reMarkable"
  root_folder: "Living Ink"

  # Optional: Whether to replicate the full reMarkable folder hierarchy.
  # true  → /Work/Projects/Q1/Note becomes {vault}/{root_folder}/Work/Projects/Q1/Note.md
  # false → all notes placed directly in {vault}/{root_folder}/
  # Default: true
  mirror_folders: true

  # Optional: Subfolder name for page images within each note's folder.
  # Set to "" to place images directly alongside notes.
  # Default: "attachments"
  attachments_folder: "attachments"
